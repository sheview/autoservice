APP_NAME="Governix - ITSM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=autoservice
DB_USERNAME=autoservice_app
DB_PASSWORD=autoservice_app
DB_MIGRATE_USERNAME=autoservice_owner
DB_MIGRATE_PASSWORD=autoservice_owner

TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PDF documents (Gotenberg, see docker-compose.yml)
GOTENBERG_URL=http://127.0.0.1:3000
GOTENBERG_TIMEOUT=30

VITE_APP_NAME="${APP_NAME}"

# --- Production (see README "Deploy") ---------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://autoservice.example.com
# TENANCY_CENTRAL_DOMAINS=autoservice.example.com
# SESSION_DOMAIN=.autoservice.example.com     # one login across company subdomains
# SESSION_SECURE_COOKIE=true
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# MAIL_MAILER=smtp
