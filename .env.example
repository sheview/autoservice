APP_NAME="Governix - ITSM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

# รหัสผ่านทุกบัญชีของ "บริษัท ตัวอย่าง จำกัด" (SampleCompanySeeder) เว้นว่าง = สุ่มให้บน production
SAMPLE_COMPANY_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB 10.11 (on Plesk: the database and user made under Databases)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autoservice
DB_USERNAME=autoservice
DB_PASSWORD=

TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1

# Keycloak SSO (empty = sign in with password only). Client: confidential, standard flow, PKCE S256.
# Valid redirect URI: KEYCLOAK_REDIRECT_URI; valid post logout redirect URIs: https://*your hosts*/login
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=governix
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REDIRECT_URI=https://autoservice.example.com/auth/sso/callback
# Make staff accounts in Keycloak from Governix: the client's service account needs
# realm-management manage-users + view-users, and the realm needs SMTP (it e-mails "set your password").
KEYCLOAK_PROVISION=false
# Companies signing in with their own AD/Entra: realm Organizations on, one Organization per company
# (its alias in the company form), the company's IdP linked to it, "organization" client scope on the client.
# Never link an IdP to the realm outside an Organization.
KEYCLOAK_ORGANIZATIONS=false
# Back-channel logout URL (client settings, "session required" on): https://autoservice.example.com/auth/sso/backchannel-logout

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Backups (Platform → สำรองข้อมูล): where they go — best another disk/mount than the system's —
# and the zip password (AES-256). Keep the password and APP_KEY OUTSIDE this server too
# (a password manager): without them a backup cannot be opened or its encrypted columns read.
BACKUP_PATH=
BACKUP_ARCHIVE_PASSWORD=
# Folder of mariadb-dump when not on PATH, with a trailing slash (e.g. C:/mariadb11/bin/)
DB_DUMP_BINARY_PATH=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PDF documents (Gotenberg, see docker-compose.yml)
GOTENBERG_URL=http://127.0.0.1:3000
GOTENBERG_TIMEOUT=30

VITE_APP_NAME="${APP_NAME}"

# --- Production (see README "Deploy") ---------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://autoservice.example.com
# TENANCY_CENTRAL_DOMAINS=autoservice.example.com
# TRUSTED_PROXIES=*                          # behind nginx/a proxy that ends HTTPS (only if the app port is not public)
# SESSION_DOMAIN=.autoservice.example.com     # one login across company subdomains
# SESSION_SECURE_COOKIE=true
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# MAIL_MAILER=smtp
